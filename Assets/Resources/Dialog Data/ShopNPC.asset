  firstTimeLines:
  - speakerName: "Th\u01B0\u01A1ng nh\xE2n"
    sentence: "Ch\xE0o ch\xE0ng trai tr\u1EBB."
  - speakerName: "Th\u01B0\u01A1ng nh\xE2n"
    sentence: "C\xF3 v\u1EBB nh\u01B0 c\u1EADu \u0111ang g\u1EB7p kh\xF3 kh\u0103n."
  - speakerName: "Th\u01B0\u01A1ng nh\xE2n"
    sentence: "T\xF4i c\xF3 m\u1ED9t s\u1ED1 m\xF3n \u0111\u1ED3 c\xF3 th\u1EC3 gi\xFAp
      c\u1EADu, mu\u1ED1n xem qua ch\u1EE9 ?"
