--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e2d9d1d2b876e2240a892b9c23041b9e, type: 3}
  m_Name: StoryBossPhase2
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  firstTimeLines: []
  defaultLines:
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "Ch\xE0o m\u1EEBng quay tr\u1EDF l\u1EA1i ho\xE0ng t\u1EED Arthur."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "Th\u1EA7n c\xF3 m\u1EAFt kh\xF4ng th\u1EA5y th\xE1i d\u01B0\u01A1ng,
      ng\xE0n l\u1EA7n xin \u0111i\u1EC7n h\u1EA1 tha t\u1ED9i."
  - speakerName: "Th\xE1nh k\u1ECB s\u0129"
    sentence: "Chuy\u1EC7n n\xE0y l\xE0 nh\u01B0 n\xE0o ch\u1EE9???"
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "C\xF3 l\u1EBD do tr\u1EADn chi\u1EBFn h\xF4m \u0111\xF3, \u0111i\u1EC7n
      h\u1EA1 \u0111\xE3 b\u1ECB m\u1EA5t k\xFD \u1EE9c."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "L\xFAc \u0111\xF3 Th\xE1nh k\u1ECB s\u0129 Garen \u0111\xE3 b\u1EA3o
      v\u1EC7 ng\xE0i ch\u1EA1y tr\u1ED1n kh\u1ECFi l\u0169 qu\xE1i v\u1EADt \u0111ang
      tr\xE0n lan trong kinh th\xE0nh."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "Sau khi d\u1EB9p lo\u1EA1n, ch\xFAng th\u1EA7n \u0111\xE3 \u0111i
      t\xECm 2 ng\u01B0\u1EDDi, nh\u01B0ng th\u1EADt \u0111au l\xF2ng khi th\u1EA5y
      thi th\u1EC3 ng\xE0i Garen..."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "Ch\xFAng th\u1EA7n \u0111\xE3 cho r\u1EB1ng \u0111i\u1EC7n h\u1EA1
      c\u0169ng \u0111\xE3 ng\xE3 xu\u1ED1ng \u1EDF \u0111\xE2u \u0111\xF3..."
  - speakerName: "Th\xE1nh k\u1ECB s\u0129"
    sentence: "M\xECnh l\xE0... Arthur. Ho\xE0ng t\u1EED c\u1EE7a Demacia... "
  - speakerName: "Th\xE1nh k\u1ECB s\u0129"
    sentence: "H\xE0ng t\u1EA5n k\xFD \u1EE9c \u0111ang \xF9a v\u1EC1 trong \u0111\u1EA7u. "
  - speakerName: "Th\xE1nh k\u1ECB s\u0129"
    sentence: "Garen... C\u1EADu \u0111\xE3 hy sinh \u0111\u1EC3 b\u1EA3o v\u1EC7
      ta, th\u1EADm ch\xED c\xF2n c\u1EDFi b\u1ECF th\xE1nh gi\xE1p cho ta m\u1EB7c."
  - speakerName: "Th\xE1nh k\u1ECB s\u0129"
    sentence: "Ta \u0111\xE3 quay v\u1EC1 r\u1ED3i, l\u1EA7n n\xE0y ta nh\u1EA5t
      \u0111\u1ECBnh s\u1EBD b\u1EA3o v\u1EC7 v\u01B0\u01A1ng qu\u1ED1c."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "\u0110\u1EC3 \u1ED5n \u0111\u1ECBnh l\u1EA1i v\u01B0\u01A1ng qu\u1ED1c
      sau tr\u1EADn chi\u1EBFn Ho\xE0ng Th\xFAc c\u1EE7a ng\xE0i \u0111\xE3 n\u1EAFm
      quy\u1EC1n \u0111i\u1EC1u h\xE0nh \u0111\u1EA5t n\u01B0\u1EDBc, v\xE0 s\u1EAFp
      t\u1EDBi s\u1EBD ch\xEDnh th\u1EE9c l\xEAn ng\xF4i."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "Gi\u1EDD ng\u01B0\u1EDDi th\u1EEBa k\u1EBF ngai v\xE0ng h\u1EE3p ph\xE1p
      \u0111\xE3 quay l\u1EA1i r\u1ED3i. Ng\u01B0\u1EDDi d\xE2n v\xE0 binh l\xEDnh
      ch\u1EAFc h\u1EB3n s\u1EBD r\u1EA5t vui m\u1EEBng \u1EE7ng h\u1ED9."
  - speakerName: "Hi\u1EC7p s\u0129"
    sentence: "N\xE0o, gi\u1EDD h\xE3y \u0111\u1EC3 th\u1EA7n d\u1EABn \u0111i\u1EC7n
      h\u1EA1 \u0111i g\u1EB7p Ho\xE0ng Th\xFAc c\u1EE7a m\xECnh."
